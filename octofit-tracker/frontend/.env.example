# Codespace Environment Configuration
# For local development, use localhost:
# REACT_APP_CODESPACE_NAME=

# For Codespace, set the CODESPACE_NAME from GitHub environment variable:
# REACT_APP_CODESPACE_NAME=your-codespace-name

# Example with a real codespace name:
# REACT_APP_CODESPACE_NAME=my-codespace-12345

# API endpoint will be constructed as:
# - Codespace: https://${REACT_APP_CODESPACE_NAME}-8000.app.github.dev/api
# - Local: http://localhost:8000/api

